
Algoritmo CelsiusAFahrenheit
	
	Definir celsius, fahrenheit Como Real
	Definir MULTIPLICADOR, SUMA Como Real
	
	MULTIPLICADOR <- 9/5
	SUMA <- 32
	
	Escribir "Digite la temperatura en grados Celsius:"
	Leer celsius
	
	fahrenheit <- (celsius * MULTIPLICADOR) + SUMA
	
	Escribir "La temperatura en grados Celsius es: ", celsius
	Escribir "La temperatura en grados Fahrenheit es: ", fahrenheit
	
FinAlgoritmo

